{
  "name": "dsh-media-reader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "视频与 GIF 原始附件导入、按时间抽帧及当前模型读取。",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "vendor",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": "0.2.1-rc.2"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test test/media.test.mjs",
    "test:portable": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/test-portable.ps1",
    "test:package": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/test-package.ps1",
    "test:contract": "node --test test/host-contract.test.mjs test/host-route.test.mjs",
    "test:browser": "node --test test/browser.test.mjs",
    "restore:vendor": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/restore-vendor.ps1",
    "package": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/package.ps1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-plugin-hub",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
